# variables de entorno de PRUEBAS

# nombre del ambiente al que apuntan las variables de entorno
NEXT_PUBLIC_NODE_ENV=test

# usuario y clave quemados para inicio de sesion automatico en local host
NEXT_PUBLIC_AUTH_USER=aqui_escribir_USUARIO_quemado_en_login_en_PRUEBAS
NEXT_PUBLIC_AUTH_PASSWORD=aqui_escribir_CONTRASEÑA_quemado_en_login_en_PRUEBAS

# URL de backend donde se hacen las peticiones HTTP
NEXT_PUBLIC_API=http://aqui_escribir_dominio_de_pruebas:3000/api/v1/
