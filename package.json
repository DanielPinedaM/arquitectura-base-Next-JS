{
  "name": "frontend-next-js",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "start:local": "env-cmd -f ./environments/.env.localhost -- next dev -p 4100",
    "start:prod": "env-cmd -f ./environments/.env.production -- next dev -p 4100",
    "start:test": "env-cmd -f ./environments/.env.test -- next dev -p 4100",
    "build:prod": "env-cmd -f ./environments/.env.production -- node --max_old_space_size=100000 ./node_modules/next/dist/bin/next build",
    "build:test": "env-cmd -f ./environments/.env.test -- node --max_old_space_size=100000 ./node_modules/next/dist/bin/next build",
    "start": "next start -p 2000",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/error-message": "^2.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@types/crypto-js": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/luxon": "^3.7.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "echarts-for-react": "^3.0.6",
    "embla-carousel-react": "^8.6.0",
    "env-cmd": "^11.0.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "just-debounce-it": "^3.2.0",
    "luxon": "^3.7.2",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-day-picker": "~10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "sass": "^1.104.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "title-case": "^4.3.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.18",
    "@types/node": "^26.6.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  }
}
