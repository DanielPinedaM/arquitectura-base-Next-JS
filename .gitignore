# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules/*
# Excepcion: la documentacion oficial de Next.js si se sube al repositorio remoto
!/node_modules/next/
/node_modules/next/*
!/node_modules/next/dist/
/node_modules/next/dist/*
!/node_modules/next/dist/docs/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Manejadores de paquetes diferente a pnpm
package-lock.json
/.pnp
.pnp.*
yarn.lock
.yarn/*
yarn-debug.log*
yarn-error.log*

# IA
.playwright-cli
# Archivos temporales con el mensaje de los commits que genera la skill git-commit
.claude/skills/git-commit/*.txt
